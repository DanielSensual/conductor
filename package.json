{
  "name": "conductor-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Visual IDE for Multi-Agent AI Workflows",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "npm@10.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanielSensual/conductor.git"
  },
  "keywords": [
    "ai",
    "agents",
    "langgraph",
    "workflow",
    "visual-programming",
    "llm",
    "orchestration"
  ],
  "license": "MIT"
}
